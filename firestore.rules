rules_version = '2';
// Regole per la segnaletica SRM 2026.
// Ogni squadra vive sotto /squadre/{codice}: chi non conosce il codice non può
// né leggere né elencare nulla. L'accesso richiede l'accesso anonimo di Firebase.
service cloud.firestore {
  match /databases/{database}/documents {

    function entrato() { return request.auth != null; }
    function codiceValido(squadra) { return squadra.size() >= 4 && squadra.size() <= 40; }

    match /squadre/{squadra} {
      allow read, write: if false;            // l'elenco delle squadre non è mai leggibile

      match /segnali/{id} {
        allow read: if entrato() && codiceValido(squadra);
        allow create, update: if entrato() && codiceValido(squadra)
          && request.resource.data.lat is number && request.resource.data.lon is number
          && request.resource.data.stato in ['da_verificare', 'verificato', 'posato', 'rimosso'];
        allow delete: if entrato() && codiceValido(squadra);
      }

      // storia delle azioni: si aggiunge soltanto, non si modifica e non si cancella
      match /eventi/{id} {
        allow read: if entrato() && codiceValido(squadra);
        allow create: if entrato() && codiceValido(squadra)
          && request.resource.data.uid == request.auth.uid
          && (!('foto' in request.resource.data) || request.resource.data.foto.size() < 400000);
        allow update, delete: if false;
      }

      // presidi lungo il percorso: nome, posizione, persone con telefono e ruolo, note
      match /presidi/{id} {
        allow read, delete: if entrato() && codiceValido(squadra);
        allow create, update: if entrato() && codiceValido(squadra)
          && request.resource.data.lat is number && request.resource.data.lon is number
          && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 80
          && (!('persone' in request.resource.data) || (request.resource.data.persone is list && request.resource.data.persone.size() <= 30));
      }

      // posizione dei volontari: ognuno scrive solo la propria
      match /volontari/{uid} {
        allow read: if entrato() && codiceValido(squadra);
        allow write: if entrato() && codiceValido(squadra) && request.auth.uid == uid;
      }
    }
  }
}
